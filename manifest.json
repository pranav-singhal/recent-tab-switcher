{
  "manifest_version": 3,
  "name": "Recent Tab Switcher",
  "version": "1.1.0",
  "description": "Hold a key and tap to switch tabs in most-recently-used order.",
  "permissions": ["tabs", "scripting", "favicon", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Recent Tab Switcher settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["_favicon/*"], "matches": ["<all_urls>"] }
  ],
  "commands": {
    "previous-tab": {
      "suggested_key": { "default": "Alt+Q", "mac": "Alt+Q" },
      "description": "Jump to the previous tab (works on every page)"
    }
  }
}
